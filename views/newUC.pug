            <label>Sala</label>
            <input class="w3-input w3-round horario-sala" type="text" placeholder="Sala" data-field="sala" required>
          </div>
        </div>
        <input type="hidden" name="horario[${kind}][]" value="" data-original="">
      `;
      container.appendChild(wrapper);
