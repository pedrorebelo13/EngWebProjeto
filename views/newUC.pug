extends layout

block content
  .w3-card-4
    header.w3-container.w3-purple
      h2= uc ? `Editar UC #${uc.id}` : "Nova UC"
    
    form.w3-container.w3-padding-16(method="POST" action=uc ? `/uc/edit/${uc.id}` : "/uc")
      fieldset
        legend Metadata
        if uc 
          input(type="hidden" name="id" value=uc.id)
        
        label Sigla 
        input.w3-input.w3-round(type="text" name="sigla" value=uc ? uc.sigla : "")
        
        label Título
        input.w3-input.w3-round(type="text" name="titulo" value=uc ? uc.titulo : "")

        label Ano
        input.w3-input.w3-round(type="text" name="ano" value=uc ? uc.ano : "")

        label Docentes
        input.w3-input.w3-round(type="text" name="docentes" value=uc ? uc.docentes : "")

        label Horario
        input.w3-input.w3-round(type="text" name="horario" value=uc ? uc.horario : "")

        label Avaliação
        input.w3-input.w3-round(type="text" name="avaliação" value=uc ? uc.avaliação : "")

        label Datas 
        input.w3-input.w3-round(type="text" name="datas" value=uc ? uc.datas : "")
        
        label Aulas 
        input.w3-input.w3-round(type="text" name="aulas" value=uc ? uc.aulas : "")
      
      button.w3-btn.w3-purple.w3-margin-top(type="submit")= uc ? "Update" : "Insert"
      a.w3-btn.w3-grey.w3-margin-top.w3-margin-left(href="/") Cancel