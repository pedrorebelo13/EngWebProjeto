extends layout

block content
  - var colorMap = { 'red': '#f54245', 'pink': '#e91e63', 'purple': '#9c27b0', 'deep-purple': '#673ab7', 'indigo': '#3f51b5', 'blue': '#2196f3', 'teal': '#009688', 'light-green': '#8bc34a', 'yellow': '#ffeb3b', 'orange': '#ff9800', 'brown': '#795548', 'white': '#ffffff', 'gray': '#9e9e9e', 'black': '#000000' };
  - var getColor = (colorName) => colorMap[colorName] || colorName;
  - var canManage = user && (user.role === 'admin' || (user.role === 'docente' && uc && uc.createdBy && String(uc.createdBy) === user.id));
  style.
    body { margin: 0; overflow: hidden; }
    body > footer { display: none; }
    .uc-fullscreen { height: 100vh; display: flex; flex-direction: column; margin: 0; border-radius: 0; }
    .uc-content { flex: 1; min-height: 0; overflow: auto; }

  .w3-card-4.uc-fullscreen
    header.w3-container.w3-black(style='display: flex; justify-content: space-between; align-items: center; padding: 16px 16px;')
      h1(style='margin: 0; flex: 1;') #{uc.sigla} - #{uc.titulo}
      if user
        div(style='position: relative; flex-shrink: 0; display: flex; gap: 10px; align-items: center;')
          if user.role === 'admin'
            a.w3-button.w3-black.w3-round.w3-hover-white.w3-margin-right.w3-border(href='/users/list' style='font-size: 14px; font-weight: bold;') Utilizadores         
            button.profile-btn.w3-button.w3-round(onclick='toggleProfile()' style='font-size: 24px;') 👤
          div#profileMenu.w3-dropdown-content.w3-bar-block.w3-border(style='display:none; position:absolute; right:0; top:100%; background-color:#f1f1f1; z-index:10; min-width:200px;')
            .w3-bar-item
              strong=user.name
              br
              small=user.email
            .w3-bar-item.w3-border-top
              form.w3-bar-item(action='/auth/logout' method='POST' style='padding: 0;')
                button.w3-button.w3-block.w3-text-left.w3-text-red.w3-hover-red(type='submit') Logout

    .w3-container.uc-content
      if uc.website.tipo == 'A'
        include ./opcA.pug
      else if uc.website.tipo == 'B'
        include ./opcB.pug
      else if uc.website.tipo == 'C'
        include ./opcC.pug
        
  script.
    function deleteUC(id) {
      if (confirm("Tens a certeza que queres apagar esta UC?")) {
        fetch('/uc/ucs/' + id, {
          method: 'DELETE'
        })
        .then(response => {
          if (response.ok) {
            window.location.href = '/uc/ucs?deleted=true'; // Redireciona e avisa do sucesso
          } else {
            alert("Erro ao apagar a UC.");
          }
        })
        .catch(error => {
          console.error("Erro:", error);
          alert("Ocorreu um erro de rede ao tentar apagar a UC.");
        });
      }
    }
    
    function toggleProfile() {
      const menu = document.getElementById('profileMenu');
      if (menu.style.display === 'none') {
        menu.style.display = 'block';
      } else {
        menu.style.display = 'none';
      }
    }
    
    // Fechar o menu ao clicar fora
    document.addEventListener('click', function(event) {
      const menu = document.getElementById('profileMenu');
      const button = event.target.closest('button');
      if (!button && menu && menu.style.display === 'block') {
        menu.style.display = 'none';
      }
    });
