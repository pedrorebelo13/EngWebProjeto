extends layout

block content
  .w3-card-4
    if success
      .w3-panel.w3-green.w3-display-container.w3-margin(style='position:relative;')
        span.w3-button.w3-display-topright(style='font-size:24px;' onclick="this.parentElement.style.display='none'") &times;
        h3 Sucesso!
        p A nova Unidade Curricular foi adicionada à base de dados.
    if deleted
      .w3-panel.w3-red.w3-display-container.w3-margin(style='position:relative;')
        span.w3-button.w3-display-topright(style='font-size:24px;' onclick="this.parentElement.style.display='none'") &times;
        h3 Sucesso!
        p A Unidade Curricular foi apagada da base de dados.

    header.w3-container.w3-black(style='display: flex; justify-content: space-between; align-items: center; padding: 16px 16px;')
      h1(style='margin: 0; flex: 1;')
        span.w3-serif Lista de Unidades Curriculares
      if user
        div(style='position: relative; flex-shrink: 0; display: flex; gap: 10px; align-items: center;')
          if user.role === 'admin'
            a.w3-button.w3-black.w3-round.w3-hover-white.w3-margin-right.w3-border(href='/users/list' style='font-size: 14px; font-weight: bold;') Utilizadores
          button.profile-btn.w3-button.w3-round(onclick='toggleProfile()' style='font-size: 24px;') 👤
          div#profileMenu.w3-dropdown-content.w3-bar-block.w3-border(style='display:none; position:absolute; right:0; top:100%; background-color:#f1f1f1; z-index:10; min-width:200px;')
            .w3-bar-item
              strong=user.name
              br
              small=user.email
            .w3-bar-item.w3-border-top
              form.w3-bar-item(action='/auth/logout' method='POST' style='padding: 0;')
                button.w3-button.w3-block.w3-text-left.w3-text-red.w3-hover-red(type='submit') Logout
    
    .w3-container
      div(style='display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-top: 15px;')
        a.w3-button.w3-border.w3-text-blue.w3-hover-blue.w3-round(href='/uc/ucs/new' style='font-weight: bold;') Adicionar Nova Unidade Curricular +
        
        - var nextSiglaOrder = (currentSort === 'sigla' && currentOrder === 'asc') ? 'desc' : 'asc'
        a.w3-button.w3-border.w3-text-indigo.w3-hover-indigo.w3-round(href=`/uc/ucs?sort=sigla&order=${nextSiglaOrder}` style='font-weight: bold;') Ordenar por Sigla #{currentSort === 'sigla' && currentOrder === 'asc' ? '↑' : '↓'}
        
        - var nextAnoOrder = (currentSort === 'ano' && currentOrder === 'asc') ? 'desc' : 'asc'
        a.w3-button.w3-border.w3-text-indigo.w3-hover-indigo.w3-round(href=`/uc/ucs?sort=ano&order=${nextAnoOrder}` style='font-weight: bold;') Ordenar por Ano #{currentSort === 'ano' && currentOrder === 'asc' ? '↑' : '↓'}

      .w3-border.w3-round-large(style='margin-top: 12px; padding: 12px; background-color: #f7f7f7;')
        form(method='GET' action='/uc/ucs' style='display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; align-items: end;')
          div(style='display: flex; flex-direction: column; gap: 4px;')
            label(style='font-size: 12px; color: #555; font-weight: 600;') Nome ou Sigla
            input.w3-input.w3-border.w3-round(type='text' name='search' placeholder='Pesquisar por nome ou sigla...' value=search || '' style='height: 38px; font-size: 14px; line-height: 1.3; padding: 8px 10px; box-sizing: border-box;')
          div(style='display: flex; flex-direction: column; gap: 4px;')
            label(style='font-size: 12px; color: #555; font-weight: 600;') Ano
            select.w3-select.w3-border.w3-round(name='ano' style='height: 38px; font-size: 14px;')
              option(value='') Todos os anos
              - var anos = [];
              - var currentYear = new Date().getFullYear();
              - for (var y = currentYear; y >= 1976; y--) { anos.push(y); }
              each ano in anos
                option(value=ano selected=String(filterAno || '') === String(ano)) #{ano}
          input(type='hidden' name='sort' value=currentSort)
          input(type='hidden' name='order' value=currentOrder)
          button.w3-button.w3-indigo.w3-round(type='submit' style='font-weight: bold; height: 38px;') 🔍 Pesquisar
    .w3-container
      table.w3-table-all.w3-margin-top
        thead
          tr
            th Sigla
            th Disciplina
            th Ano 
            th Link
        tbody
          each t in list
            tr
              td= t.sigla
              td= t.titulo
              td= t.ano
              td
                a.w3-button.w3-teal.w3-round(href=`/uc/ucs/${t._id}`) Ver Website

  script.
    function toggleProfile() {
      const menu = document.getElementById('profileMenu');
      if (menu.style.display === 'none') {
        menu.style.display = 'block';
      } else {
        menu.style.display = 'none';
      }
    }
    
    // Fechar o menu ao clicar fora
    document.addEventListener('click', function(event) {
      const menu = document.getElementById('profileMenu');
      const button = event.target.closest('button');
      if (!button && menu && menu.style.display === 'block') {
        menu.style.display = 'none';
      }
    });