extends layout

block content
  .w3-card-4.w3-margin
    header.w3-container.w3-blue
      h2 Início de Sessão

    if error
      .w3-panel.w3-red.w3-margin
        p= error

    if notice
      .w3-panel.w3-blue.w3-margin
        p= notice

    form.w3-container.w3-padding-16(method='POST' action='/auth/login')
      label Username ou Email
      input.w3-input.w3-round.w3-margin-bottom(type='text' name='identifier' required)

      label Password
      input.w3-input.w3-round.w3-margin-bottom(type='password' name='password' required)

      button.w3-btn.w3-blue(type='submit') Entrar
      a.w3-btn.w3-grey.w3-margin-left(href='/auth/register') Criar conta
