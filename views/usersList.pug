extends layout

block content
  .w3-card-4
    header.w3-container.w3-black(style='display: flex; justify-content: space-between; align-items: center; padding: 16px 16px;')
      h1(style='margin: 0; flex: 1;')
        span.w3-serif Lista de Utilizadores
      if user
        div(style='position: relative; flex-shrink: 0; display: flex; gap: 10px; align-items: center;')
          if user.role === 'admin'
            a.w3-button.w3-black.w3-round.w3-hover-white.w3-margin-right.w3-border(href='/users/list' style='font-size: 14px; font-weight: bold;') Utilizadores         
            button.profile-btn.w3-button.w3-round(onclick='toggleProfile()' style='font-size: 24px;') 👤
          div#profileMenu.w3-dropdown-content.w3-bar-block.w3-border(style='display:none; position:absolute; right:0; top:100%; background-color:#f1f1f1; z-index:10; min-width:200px;')
            .w3-bar-item
              strong=user.name
              br
              small=user.email
            .w3-bar-item.w3-border-top
              form.w3-bar-item(action='/auth/logout' method='POST' style='padding: 0;')
                button.w3-button.w3-block.w3-text-left.w3-text-red.w3-hover-red(type='submit') Logout

    .w3-container
      table.w3-table-all.w3-margin-top
        thead
          tr
            th Username
            th Nome
            th Email
            th Filiação
            th Role
            th Aprovado
            th Registado em
            th Último Acesso
            th Ações
        tbody
          each u in users
            tr
              td= u.username
              td= u.name
              td= u.email
              td= u.filiacao || '-'
              td
                span.w3-tag(class=u.role === 'admin' ? 'w3-red' : u.role === 'docente' ? 'w3-orange' : 'w3-blue')= u.role
              td
                if u.role === 'docente'
                  span.w3-tag(class=u.docenteAprovado === false ? 'w3-red' : 'w3-green')= u.docenteAprovado === false ? 'Não' : 'Sim'
                else
                  span -
              td= new Date(u.dataRegisto).toLocaleDateString('pt-PT') + ' ' + new Date(u.dataRegisto).toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' })
              td= u.dataUltimoAcesso ? new Date(u.dataUltimoAcesso).toLocaleDateString('pt-PT') + ' ' + new Date(u.dataUltimoAcesso).toLocaleTimeString('pt-PT', { hour: '2-digit', minute: '2-digit' }) : '-'
              td
                a.w3-button.w3-blue.w3-small.w3-round(href=`/users/${u._id}/edit`) Editar
                if user && user.id && ('' + u._id) !== user.id
                  button.w3-button.w3-red.w3-small.w3-round.w3-margin-left(onclick=`deleteUser('${u._id}')`) Apagar

    .w3-container.w3-margin-top
            a.w3-button.w3-teal.w3-margin-top.w3-round.w3-margin-bottom(href='/uc/ucs') Voltar

  script.
    function deleteUser(id) {
      if (confirm('Tens a certeza que queres apagar este utilizador?')) {
        fetch('/users/' + id, {
          method: 'DELETE',
          headers: {
            'Accept': 'application/json'
          }
        })
        .then(response => {
          if (response.ok) {
            window.location.reload();
          } else {
            alert('Erro ao apagar o utilizador.');
          }
        })
        .catch(error => {
          console.error('Erro:', error);
          alert('Ocorreu um erro de rede ao tentar apagar o utilizador.');
        });
      }
    }
    function toggleProfile() {
      var menu = document.getElementById('profileMenu');
      menu.style.display = menu.style.display === 'none' ? 'block' : 'none';
    }

    window.onclick = function(event) {
      if (!event.target.matches('.profile-btn') && !event.target.closest('#profileMenu')) {
        var menu = document.getElementById('profileMenu');
        menu.style.display = 'none';
      }
    }
