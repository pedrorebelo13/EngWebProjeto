extends layout

block content
  .w3-card-4.w3-margin
    header.w3-container.w3-indigo
      h2 Editar Utilizador

    form.w3-container.w3-padding-16(method='POST' action=`/users/${targetUser._id}`)
      label Username
      input.w3-input.w3-round.w3-margin-bottom(type='text' name='username' value=targetUser.username required)

      label Nome
      input.w3-input.w3-round.w3-margin-bottom(type='text' name='name' value=targetUser.name required)

      label Email
      input.w3-input.w3-round.w3-margin-bottom(type='email' name='email' value=targetUser.email required)

      label Filiação
      input.w3-input.w3-round.w3-margin-bottom(type='text' name='filiacao' value=targetUser.filiacao placeholder='Estudante, docente, curso, departamento, ...')

      label Role
      select.w3-select.w3-round.w3-margin-bottom(name='role')
        option(value='aluno' selected=targetUser.role === 'aluno') Aluno
        option(value='docente' selected=targetUser.role === 'docente') Docente
        option(value='admin' selected=targetUser.role === 'admin') Admin

      label Docente aprovado
      div.w3-margin-bottom
        label.w3-margin-right
          input.w3-check(type='checkbox' name='docenteAprovado' checked=(targetUser.docenteAprovado !== false))
          span.w3-margin-left Aprovado para acesso (aplica-se apenas a docentes)

      label Password (opcional)
      input.w3-input.w3-round.w3-margin-bottom(type='password' name='password' placeholder='Deixa vazio para manter a password atual')

      button.w3-btn.w3-indigo(type='submit') Guardar
      a.w3-btn.w3-grey.w3-margin-left(href='/users/list') Cancelar
