div(style=`display: flex; gap: 20px; margin-top: 20px; height: 700px;`)
  // Sidebar Esquerda
  div(style='flex: 0 0 35%; padding: 20px; background-color: #f5f5f5; overflow-y: auto;')
    // Header com cor principal
    div(style=`background-color: ${getColor(uc.website.corPrincipal) || '#17a2b8'}; color: white; padding: 15px; margin: -20px -20px 15px -20px;`)
      h2(style='margin: 0; font-size: 24px;')= uc.sigla
      
    // Docentes
    if uc.docentes && uc.docentes.length > 0
      div(style='margin-bottom: 20px;')
        h4(style='margin: 10px 0; display: flex; align-items: center; gap: 8px;')
          span 👤
          | Docentes
        ul(style='list-style: none; padding: 0; margin: 10px 0;')
          each docente in uc.docentes
            li(style='padding: 8px 0; border-bottom: 1px solid #ddd;')
              strong= docente.nome
              if docente.email
                br
                small(style='color: #666;')= docente.email

    // Departamento/Filiação
    div(style='margin-bottom: 20px;')
      h4(style='margin: 10px 0; display: flex; align-items: center; gap: 8px;')
        span 🏢
        | Informação
      p(style='margin: 5px 0; color: #666;')
        strong Ano:
        | #{uc.ano}

    // Horário
    if uc.horario
      div(style='margin-bottom: 20px;')
        h4(style='margin: 10px 0; display: flex; align-items: center; gap: 8px;')
          span 🕐
          | Horário
        if uc.horario.teoricas && uc.horario.teoricas.length > 0
          p(style='margin: 8px 0;')
            strong Aula(s) Teórica(s):
            ul(style='margin: 5px 0; padding-left: 20px;')
              each aula in uc.horario.teoricas
                li= aula
        if uc.horario.praticas && uc.horario.praticas.length > 0
          p(style='margin: 8px 0;')
            strong Aula(s) Prática(s):
            ul(style='margin: 5px 0; padding-left: 20px;')
              each aula in uc.horario.praticas
                li= aula

    // Avaliação
    if uc.avaliacao && uc.avaliacao.length > 0
      div(style='margin-bottom: 20px;')
        h4(style='margin: 10px 0; display: flex; align-items: center; gap: 8px;')
          span 📊
          | Avaliação
        ul(style='list-style: none; padding: 0; margin: 0;')
          each item in uc.avaliacao
            li(style='padding: 6px 0; color: #555;')= item

    // Datas Importantes
    if uc.datas
      div(style='margin-bottom: 20px;')
        h4(style='margin: 10px 0; display: flex; align-items: center; gap: 8px;')
          span 📅
          | Datas Importantes
        if uc.datas.teste
          p(style='margin: 6px 0; color: #555;')
            strong Teste:
            | #{new Date(uc.datas.teste).toLocaleDateString('pt-PT')}
        if uc.datas.projeto
          p(style='margin: 6px 0; color: #555;')
            strong Projeto:
            | #{new Date(uc.datas.projeto).toLocaleDateString('pt-PT')}

  // Conteúdo Direita - Aulas
  div(style='flex: 1; display: flex; flex-direction: column; overflow: hidden;')
    div(style=`background-color: ${getColor(uc.website.corPrincipal) || '#17a2b8'}; color: white; padding: 12px 15px; flex-shrink: 0;`)
      h3(style='margin: 0; font-size: 18px;') Aulas
    
    div(style='flex: 1; overflow-y: auto; background-color: white;')
      if uc.aulas && uc.aulas.length > 0
        table.w3-table-all(style='margin-top: 0; width: 100%;')
          thead(style=`background-color: ${getColor(uc.website.corPrincipal) || '#17a2b8'}; color: white; position: sticky; top: 0;`)
            tr
              th(style='width: 100px;') Tipo
              th(style='width: 100px;') Data
              th Tema
              th Descrição
          tbody
            each aula in uc.aulas
              tr(style='border-bottom: 1px solid #ddd;')
                td
                  span.w3-tag(style=`background-color: ${getColor(uc.website.corPrincipal) || '#17a2b8'}; color: white;`)
                    if aula.tipo == 'T'
                      | T
                    else if aula.tipo == 'TP'
                      | TP
                    else if aula.tipo == 'PL'
                      | PL
                    else
                      = aula.tipo
                td(style='font-size: 12px;')= aula.data ? new Date(aula.data).toLocaleDateString('pt-PT') : '-'
                td(style='font-weight: bold;')= aula.tema || '-'
                td(style='color: #666; max-width: 300px;')
                  each sumario in aula.sumario
                    div(style='font-size: 12px; line-height: 1.4;')= sumario
      else
        div(style='padding: 15px; text-align: center; color: #999;')
          p Sem aulas registadas
    
    div(style='flex-shrink: 0; padding: 12px 15px; background-color: #f9f9f9; border-top: 1px solid #ddd; display: flex; gap: 10px;')
      a.w3-button.w3-teal.w3-round(href='/uc/ucs') Voltar
      if user && (user.role === 'admin' || user.role === 'docente')
        a.w3-button.w3-blue.w3-round(href=`/uc/ucs/${uc.id}/edit`) Editar
        button.w3-button.w3-red.w3-round(onclick=`deleteUC('${uc.id}')`) Apagar

    if user && (user.role === 'admin' || user.role === 'docente')
      details.w3-margin-top
        summary.w3-button.w3-light-grey.w3-round Importar/Exportar
        .w3-margin-top(style='display: flex; flex-wrap: wrap; gap: 8px;')
          a.w3-button.w3-border.w3-small(href=`/uc/ucs/${uc.id}/export/docentes`) Exportar Docentes
          a.w3-button.w3-border.w3-small(href=`/uc/ucs/${uc.id}/export/aulas`) Exportar Aulas
          a.w3-button.w3-border.w3-small(href=`/uc/ucs/${uc.id}/export/full`) Exportar UC Completa
        .w3-margin-top
          form(method='POST' action=`/uc/ucs/${uc.id}/import/aulas` enctype='multipart/form-data')
            div(style='display: flex; flex-wrap: wrap; gap: 8px; align-items: center;')
              span.w3-small Importar Aulas
              select.w3-select.w3-border.w3-small(name='mode')
                option(value='replace') Substituir
                option(value='append') Acrescentar
              input.w3-input.w3-border.w3-small(type='file' name='file' accept='application/json' required)
              button.w3-button.w3-small.w3-teal(type='submit') Importar
        .w3-margin-top
          form(method='POST' action=`/uc/ucs/${uc.id}/import/full` enctype='multipart/form-data')
            div(style='display: flex; flex-wrap: wrap; gap: 8px; align-items: center;')
              span.w3-small Importar UC Completa
              select.w3-select.w3-border.w3-small(name='mode')
                option(value='replace') Substituir
                option(value='append') Acrescentar
              input.w3-input.w3-border.w3-small(type='file' name='file' accept='application/json' required)
              button.w3-button.w3-small.w3-teal(type='submit') Importar
